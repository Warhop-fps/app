# Date: 06NOV2026
# Author: Minkyu Jung
# Purpose: SSM Parameter Store의 비밀 값(예 GAME_RESULT_SECRET)을 읽어 /run/fps/secrets.env(root:fps 0640)로 만든다.
#          /run은 메모리라 재부팅하면 지워지고, 부팅 때 다시 읽는다. 값은 디스크·저장소·Terraform 상태에 남지 않는다.
[Unit]
Description=Fetch game secrets from SSM Parameter Store
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/fps/deploy.env
Environment=HOME=/root
UMask=0027
ExecStartPre=/usr/bin/install -d -m 0750 -o root -g fps /run/fps
ExecStart=/usr/local/bin/node /usr/local/lib/fps/secrets.mjs /run/fps/secrets.env
ExecStartPost=/usr/bin/chgrp fps /run/fps/secrets.env
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
